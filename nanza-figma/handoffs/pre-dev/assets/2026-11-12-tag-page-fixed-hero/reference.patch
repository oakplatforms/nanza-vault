--- /dev/null
+++ b/src/components/detail/FixedBanner/index.tsx
@@ -0,0 +1,59 @@
+import React from 'react'
+import { View, Image, ImageStyle } from 'react-native'
+import LinearGradient from 'react-native-linear-gradient'
+import { useTheme } from '../../../styles/utils/ThemeProvider'
+import { getCardStyles } from '../../../styles/components/cards'
+import { getGradientProps } from '../../../styles/components/gradients'
+import { getImage, IMG_WIDTH } from '../../../utils/getImage'
+
+// The detail pages' fixed hero (Figma 3393:168141 — the listing/bid
+// treatment) in two halves, because they live in two layers:
+//
+// - FixedBannerImage: the image + top scrim, PINNED behind the scroll (pass it
+//   as PageLayout's fixedBackground, or an absolute layer behind a FlatList).
+//   The scrim stays with the floating back/share circles it keeps legible.
+// - FixedBannerFade: the transparent slot that holds the banner's place at the
+//   top of the scroll content, carrying the full-height fadeHeroFixed: clear
+//   for the top 15%, then an eased S-curve that lands on solid page background
+//   with no slope change, so there's no seam where the opaque sheet begins. It
+//   scrolls up over the pinned image with the content, fading the image out as
+//   you scroll; whatever follows it must sit on an opaque fill (cards.ts
+//   detailBannerSheet). Its own token, not fadeHeroCollapsed: that curve is
+//   the entity screen's short bottom cap.
+//
+// size: 'tag' is the tag / set pages' 290-on-402; 'standard' the 230 the
+// group / collection heroes keep.
+type BannerSize = 'tag' | 'standard'
+
+export const FixedBannerImage: React.FC<{ uri: string; size?: BannerSize }> = ({ uri, size = 'standard' }) => {
+  const { theme } = useTheme()
+  const cardStyles = getCardStyles(theme)
+  const bannerScrim = getGradientProps(theme, 'scrimTop')
+  return (
+    <View style={size === 'tag' ? cardStyles.tagDetailBanner : cardStyles.collectionDetailBanner}>
+      <Image
+        source={{ uri: getImage(uri, { width: IMG_WIDTH.BANNER }) }}
+        style={cardStyles.collectionDetailBannerImage as ImageStyle}
+      />
+      <LinearGradient
+        {...bannerScrim}
+        style={cardStyles.collectionDetailBannerScrim}
+        pointerEvents="none"
+      />
+    </View>
+  )
+}
+
+export const FixedBannerFade: React.FC<{ size?: BannerSize }> = ({ size = 'standard' }) => {
+  const { theme } = useTheme()
+  const cardStyles = getCardStyles(theme)
+  const bannerFade = getGradientProps(theme, 'fadeHeroFixed')
+  return (
+    <View
+      style={size === 'tag' ? cardStyles.tagDetailBannerSpacer : cardStyles.collectionDetailBannerSpacer}
+      pointerEvents="none"
+    >
+      <LinearGradient {...bannerFade} style={cardStyles.detailBannerFade} />
+    </View>
+  )
+}
